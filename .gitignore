# Data: never committed. Reconstructed via datakit or a documented manifest.
#
# Anchored on purpose. An unanchored `data/` pattern also matched the SOURCE package
# `src/prosumer/data/`, so `loaders.py` was silently never committed and Project 01 could not
# be imported from a fresh clone. Keep dataset directories and code packages distinguishable.
/data/
/projects/*/data/
!/projects/*/data/**/SOURCE.md
*.parquet
*.nc
*.grib
*.grib2
*.h5
*.hdf5

# Secrets
.env
*.key
*.pem

# Experiment tracking & artefacts
mlruns/
outputs/
multirun/
wandb/
checkpoints/
*.ckpt
*.pt
*.pth

# Solver / optimisation artefacts
*.lp
*.mps
*.sol
gurobi.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.uv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.hypothesis/

# Notebooks: strip outputs before committing
# (nbstripout is configured in pre-commit)

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Generated reports are committed selectively; drafts are not
reports/**/draft/

# datakit downloads
datakit/cache/
datakit/processed/
