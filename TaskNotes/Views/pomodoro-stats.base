# Pomodoro-Statistiken
# Mit Ihren TaskNotes-Einstellungen erstellt
# Erfordert die Speicherung der Pomodoro-Daten in täglichen Notizen.

filters:
  and:
    - file.hasProperty("pomodoros")
    - list(note["pomodoros"]).filter(value.startTime).isEmpty() == false

formulas:
  pomodoroDate: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.startTime).map(date(value.startTime).format("YYYY-MM-DD")).unique().join(", "), file.basename)'
  pomodoroMonth: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.startTime).map(date(value.startTime).format("YYYY-MM")).unique().join(", "), "")'
  completedPomos: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.type == "work" && value.completed == true).length, 0)'
  attemptedPomos: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.type == "work").length, 0)'
  interruptedPomos: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.type == "work" && value.completed == false).length, 0)'
  focusMinutes: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.type == "work" && value.completed == true).map(if(value.plannedDuration && value.plannedDuration > 0, value.plannedDuration, if(value.startTime && value.endTime, ((number(date(value.endTime)) - number(date(value.startTime))) / 60000).round(), 0))).reduce(acc + value, 0).round(), 0)'
  focusTime: "if(formula.focusMinutes >= 60, (if(((formula.focusMinutes / 60).floor()) >= 1000 || ((formula.focusMinutes / 60).floor()) <= -1000, (\"\" + ((formula.focusMinutes / 60).floor())).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"), (\"\" + ((formula.focusMinutes / 60).floor()))) + \" Std. \" + if(((formula.focusMinutes % 60).round()) >= 1000 || ((formula.focusMinutes % 60).round()) <= -1000, (\"\" + ((formula.focusMinutes % 60).round())).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"), (\"\" + ((formula.focusMinutes % 60).round()))) + \" Min.\"), (if((formula.focusMinutes) >= 1000 || (formula.focusMinutes) <= -1000, (\"\" + (formula.focusMinutes)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"), (\"\" + (formula.focusMinutes))) + \" Min.\"))"
  completionRate: "(if((if(formula.attemptedPomos > 0, (formula.completedPomos / formula.attemptedPomos * 100).round(), 0)) >= 1000 || (if(formula.attemptedPomos > 0, (formula.completedPomos / formula.attemptedPomos * 100).round(), 0)) <= -1000, (\"\" + (if(formula.attemptedPomos > 0, (formula.completedPomos / formula.attemptedPomos * 100).round(), 0))).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"), (\"\" + (if(formula.attemptedPomos > 0, (formula.completedPomos / formula.attemptedPomos * 100).round(), 0)))) + \" %\")"
  shortBreaks: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.type == "short-break").length, 0)'
  longBreaks: 'if(note["pomodoros"], list(note["pomodoros"]).filter(value.type == "long-break").length, 0)'

properties:
  formula.pomodoroDate:
    displayName: "Datum"
  formula.pomodoroMonth:
    displayName: "Monat"
  formula.completedPomos:
    displayName: "Abgeschlossen"
  formula.attemptedPomos:
    displayName: "Versucht"
  formula.interruptedPomos:
    displayName: "Unterbrochen"
  formula.focusMinutes:
    displayName: "Fokusminuten"
  formula.focusTime:
    displayName: "Fokuszeit"
  formula.completionRate:
    displayName: "Abschluss"
  formula.shortBreaks:
    displayName: "Kurze Pausen"
  formula.longBreaks:
    displayName: "Lange Pausen"

views:
  - type: table
    name: "Täglich"
    order:
      - formula.pomodoroDate
      - formula.completedPomos
      - formula.focusTime
      - formula.attemptedPomos
      - formula.completionRate
      - formula.interruptedPomos
      - formula.shortBreaks
      - formula.longBreaks
      - file.name
    sort:
      - column: formula.pomodoroDate
        direction: DESC
  - type: table
    name: "Monatlich"
    groupBy:
      property: formula.pomodoroMonth
      direction: DESC
    order:
      - formula.pomodoroDate
      - formula.completedPomos
      - formula.focusMinutes
      - formula.focusTime
      - formula.attemptedPomos
      - formula.completionRate
      - formula.interruptedPomos
      - formula.shortBreaks
      - formula.longBreaks
      - file.name
    summaries:
      formula.completedPomos: Sum
      formula.focusMinutes: Sum
      formula.attemptedPomos: Sum
      formula.interruptedPomos: Sum
      formula.shortBreaks: Sum
      formula.longBreaks: Sum
    sort:
      - column: formula.pomodoroDate
        direction: DESC
