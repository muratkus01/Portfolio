# Relationships
# This view shows all relationships for the current file
# Dynamically shows/hides tabs based on available data

formulas:
  priorityWeight: if(priority=="none",0,if(priority=="low",1,if(priority=="normal",2,if(priority=="high",3,999))))
  daysUntilDue: if((due.isEmpty() == false), ((number(date(due)) - number(today())) / 86400000).floor(), null)
  dueIn: if(due.isEmpty(), "", if(formula.daysUntilDue == 0, "Heute", if(formula.daysUntilDue > 0, (if((formula.daysUntilDue) == 1, (if((formula.daysUntilDue) >= 1000 || (formula.daysUntilDue) <= -1000, ("" + (formula.daysUntilDue)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue))) + " Tag"), (if((formula.daysUntilDue) >= 1000 || (formula.daysUntilDue) <= -1000, ("" + (formula.daysUntilDue)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue))) + " Tage"))), (if((formula.daysUntilDue * -1) == 1, (if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " Tag überfällig"), (if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " Tage überfällig"))))))
  daysUntilScheduled: if((scheduled.isEmpty() == false), ((number(date(scheduled)) - number(today())) / 86400000).floor(), null)
  daysSinceCreated: ((number(now()) - number(file.ctime)) / 86400000).floor()
  daysSinceModified: ((number(now()) - number(file.mtime)) / 86400000).floor()
  isOverdue: (due.isEmpty() == false) && date(due) < today() && status != "done"
  isDueToday: (due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")
  isDueThisWeek: (due.isEmpty() == false) && date(due).format("YYYY-MM-DD") >= today().format("YYYY-MM-DD") && date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")
  isScheduledToday: (scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")
  isRecurring: recurrence && !recurrence.isEmpty()
  hasTimeEstimate: timeEstimate && timeEstimate > 0
  timeRemaining: if(timeEstimate && timeEstimate > 0, timeEstimate - if(timeEntries, list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0), 0), null)
  efficiencyRatio: if(timeEstimate && timeEstimate > 0 && timeEntries, (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / timeEstimate * 100).round(), null)
  timeTrackedThisWeek: if(timeEntries, list(timeEntries).filter(value.endTime && date(value.startTime) >= today() - "7d").map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round(), 0)
  timeTrackedToday: if(timeEntries, list(timeEntries).filter(value.endTime && date(value.startTime).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round(), 0)
  dueMonth: if((due.isEmpty() == false), date(due).format("YYYY-MM"), "Kein Fälligkeitsdatum")
  dueWeek: if((due.isEmpty() == false), date(due).format("YYYY-[W]WW"), "Kein Fälligkeitsdatum")
  scheduledMonth: if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-MM"), "Nicht geplant")
  scheduledWeek: if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-[W]WW"), "Nicht geplant")
  dueDateCategory: if(due.isEmpty(), "Kein Fälligkeitsdatum", if(date(due) < today(), "Überfällig", if(date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD"), "Heute", if(date(due).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD"), "Morgen", if(date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD"), "Diese Woche", "Später")))))
  timeEstimateCategory: if(!timeEstimate || timeEstimate == 0 || timeEstimate == null, "Keine Zeitschätzung", if(timeEstimate < 30, "Kurz (<30 Min.)", if(timeEstimate <= 120, "Mittel (30 Min.–2 Std.)", "Lang (>2 Std.)")))
  ageCategory: if(((number(now()) - number(file.ctime)) / 86400000) < 1, "Heute", if(((number(now()) - number(file.ctime)) / 86400000) < 7, "Diese Woche", if(((number(now()) - number(file.ctime)) / 86400000) < 30, "Dieser Monat", "Älter")))
  createdMonth: file.ctime.format("YYYY-MM")
  modifiedMonth: file.mtime.format("YYYY-MM")
  priorityCategory: if(priority=="none","None",if(priority=="low","Low",if(priority=="normal","Normal",if(priority=="high","High","No priority"))))
  projectCount: (if((if(projects, list(projects).length, 0)) == 0, ("Keine Projekte"), if((if(projects, list(projects).length, 0)) == 1, ("Ein Projekt"), ("Mehrere Projekte"))))
  contextCount: (if((if(contexts, list(contexts).length, 0)) == 0, ("Keine Kontexte"), if((if(contexts, list(contexts).length, 0)) == 1, ("Ein Kontext"), ("Mehrere Kontexte"))))
  trackingStatus: if(!timeEstimate || timeEstimate == 0 || timeEstimate == null, "Keine Zeitschätzung", if(!timeEntries || list(timeEntries).length == 0, "Nicht begonnen", if(formula.efficiencyRatio < 100, "Unter der Schätzung", "Schätzung überschritten")))
  nextDate: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), due, scheduled), if((due.isEmpty() == false), due, scheduled))
  daysUntilNext: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), min(formula.daysUntilDue, formula.daysUntilScheduled), if((due.isEmpty() == false), formula.daysUntilDue, formula.daysUntilScheduled))
  hasDate: (due.isEmpty() == false) || (scheduled.isEmpty() == false)
  isToday: ((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == today().format("YYYY-MM-DD"))
  isThisWeek: ((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") >= today().format("YYYY-MM-DD") && date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") >= today().format("YYYY-MM-DD") && date(scheduled).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD"))
  nextDateCategory: if(due.isEmpty() && scheduled.isEmpty(), "Kein Datum", if(((due.isEmpty() == false) && date(due) < today()) || ((scheduled.isEmpty() == false) && date(scheduled) < today()), "Überfällig/Vergangen", if(((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")), "Heute", if(((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD")), "Morgen", if(((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")), "Diese Woche", "Später")))))
  nextDateMonth: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), date(due).format("YYYY-MM"), date(scheduled).format("YYYY-MM")), if((due.isEmpty() == false), date(due).format("YYYY-MM"), if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-MM"), "Kein Datum")))
  nextDateWeek: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), date(due).format("YYYY-[W]WW"), date(scheduled).format("YYYY-[W]WW")), if((due.isEmpty() == false), date(due).format("YYYY-[W]WW"), if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-[W]WW"), "Kein Datum")))
  urgencyScore: if(due.isEmpty() && scheduled.isEmpty(), formula.priorityWeight, formula.priorityWeight + max(0, 10 - if(formula.daysUntilNext, formula.daysUntilNext, 0)) + (1 - ((number(date(formula.nextDate)) - number(date(date(formula.nextDate).format("YYYY-MM-DD")))) / 86400000)))
  timeTrackedFormatted: if(timeEntries, if(list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) >= 60, (if(((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor()) >= 1000 || ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor()) <= -1000, ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor())).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor()))) + " Std. " + if(((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round()) >= 1000 || ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round()) <= -1000, ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round())).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round()))) + " Min."), (if((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round()) >= 1000 || (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round()) <= -1000, ("" + (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round())).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round()))) + " Min.")), (if((0) >= 1000 || (0) <= -1000, ("" + (0)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (0))) + " Min."))
  dueDateDisplay: if(due.isEmpty(), "", if(date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD"), "Heute", if(date(due).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD"), "Morgen", if(date(due).format("YYYY-MM-DD") == (today() - "1 day").format("YYYY-MM-DD"), "Gestern", if(date(due) < today(), (if((formula.daysUntilDue * -1) == 1, ("vor " + if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " Tag"), ("vor " + if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " Tagen"))), if(date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD"), date(due).format("ddd"), date(due).format("MMM D")))))))

views:
  - type: tasknotesKanban
    name: "Unteraufgaben"
    filters:
      and:
        - file.hasTag("task")
        - file.hasLink(this.file) && list(note.projects).map(file(value.replace(/^\[[^\]]+\]\((.*)\)$/, "$1").replace(/%20/g, " ")).asLink()).contains(this.file.asLink())
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - file.tags
      - blockedBy
      - file.name
      - recurrence
      - complete_instances
      - file.tasks
    sort:
      - column: tasknotes_manual_order
        direction: DESC
    groupBy:
      property: status
      direction: ASC
  - type: tasknotesTaskList
    name: "Vorkommen"
    filters:
      and:
        - file.hasTag("task")
        - file.hasLink(this.file) && note.recurrence_parent && file(note.recurrence_parent.replace(/^\[[^\]]+\]\((.*)\)$/, "$1").replace(/%20/g, " ")).asLink() == this.file.asLink()
    order:
      - status
      - priority
      - due
      - scheduled
      - occurrence_date
      - projects
      - contexts
      - file.tags
      - blockedBy
      - file.name
      - recurrence
      - complete_instances
      - file.tasks
    sort:
      - column: occurrence_date
        direction: ASC
  - type: tasknotesTaskList
    name: "Projekte"
    filters:
      and:
        - list(this.projects).map(file(value.replace(/^\[[^\]]+\]\((.*)\)$/, "$1").replace(/%20/g, " ")).asLink()).contains(file.asLink())
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - file.tags
      - blockedBy
      - file.name
      - recurrence
      - complete_instances
      - file.tasks
  - type: tasknotesTaskList
    name: "Blockiert durch"
    filters:
      and:
        - file.hasTag("task")
        - list(this.note.blockedBy).map(file(if(value.isType("object"), value.uid, value)).asLink()).contains(file.asLink())
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - file.tags
      - blockedBy
      - file.name
      - recurrence
      - complete_instances
      - file.tasks
    sort:
      - column: tasknotes_manual_order
        direction: DESC
  - type: tasknotesKanban
    name: "Blockiert"
    filters:
      and:
        - file.hasTag("task")
        - list(note.blockedBy).map(file(if(value.isType("object"), value.uid, value)).asLink()).contains(this.file.asLink())
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - file.tags
      - blockedBy
      - file.name
      - recurrence
      - complete_instances
      - file.tasks
    sort:
      - column: tasknotes_manual_order
        direction: DESC
    groupBy:
      property: status
      direction: ASC
